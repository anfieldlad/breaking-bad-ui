# Breaking B.A.D. UI environment variables for `npm run dev` (.env.local).
# On Cloudflare they come from wrangler.jsonc vars + Worker secrets instead.
# Server-side only.
# These are read by the /api route handlers and are NEVER sent to the browser.
# Do not prefix them with NEXT_PUBLIC_.

# Backend base URL
# Local development: http://localhost:8000
# Production: https://your-backend-host
BACKEND_URL=http://localhost:8000

# Must match the backend's API_KEY
BACKEND_API_KEY=your_secret_api_key
